---
import Layout from '../layouts/Layout.astro';
import { useState } from 'astro/runtime/server/index.js';

const [prompt, setPrompt] = useState('');
const [isGenerating, setIsGenerating] = useState(false);
const [generatedImage, setGeneratedImage] = useState('');
const [error, setError] = useState('');

const generateArt = async () => {
  if (!prompt.trim()) return;
  
  setIsGenerating(true);
  setError('');
  
  try {
    // Using a free image generation API for demo purposes
    const response = await fetch('https://api.openai.com/v1/images/generations', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${import.meta.env.OPENAI_API_KEY}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        model: 'dall-e-3',
        prompt: `Cosmic astrology-themed art: ${prompt}. Celestial scene with zodiac symbols, cosmic colors, mystical elements, neon accents, and celestial formations. Professional digital art style.`,
        n: 1,
        size: '1024x1024',
        quality: 'standard',
      }),
    });

    if (!response.ok) {
      throw new Error('Failed to generate image');
    }

    const data = await response.json();
    setGeneratedImage(data.data[0].url);
  } catch (err) {
    setError(err.message || 'Failed to generate art. Please check your API key.');
  } finally {
    setIsGenerating(false);
  }
};
---

<Layout title="Cosmic Art Generator">
  <div class="min-h-screen bg-gradient-to-br from-purple-900 via-blue-900 to-indigo-900">
    <div class="container mx-auto px-4 py-8">
      <div class="max-w-4xl mx-auto">
        <header class="text-center mb-12">
          <h1 class="text-5xl font-bold text-white mb-4">🎨 Cosmic Art Generator</h1>
          <p class="text-xl text-purple-200">Create stunning cosmic artwork with AI</p>
        </header>

        <div class="bg-white/10 backdrop-blur-lg rounded-2xl p-8 shadow-2xl">
          <div class="mb-8">
            <label class="block text-white text-lg font-semibold mb-4">
              Describe your cosmic vision:
            </label>
            <div class="flex gap-4">
              <input
                type="text"
                value={prompt}
                onInput={(e) => setPrompt(e.target.value)}
                placeholder="Cosmic owl with zodiac wings..."
                class="flex-1 px-4 py-3 rounded-lg bg-white/20 text-white placeholder-purple-200 border border-purple-300 focus:outline-none focus:border-purple-400"
              />
              <button
                onClick={generateArt}
                disabled={isGenerating}
                class="px-8 py-3 bg-gradient-to-r from-purple-500 to-pink-500 text-white rounded-lg font-semibold hover:from-purple-600 hover:to-pink-600 disabled:opacity-50 disabled:cursor-not-allowed transition-all duration-200"
              >
                {isGenerating ? 'Creating...' : 'Generate Art'}
              </button>
            </div>
          </div>

          {isGenerating && (
            <div class="text-center py-12">
              <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-white mb-4"></div>
              <p class="text-white text-lg">Creating cosmic art with AI...</p>
            </div>
          )}

          {error && (
            <div class="bg-red-500/20 border border-red-400 rounded-lg p-4 mb-6">
              <p class="text-red-200">{error}</p>
              <p class="text-red-300 text-sm mt-2">
                Make sure you have your OpenAI API key configured and DALL-E access enabled.
              </p>
            </div>
          )}

          {generatedImage && (
            <div class="space-y-6">
              <div class="bg-white/5 rounded-xl overflow-hidden shadow-xl">
                <img 
                  src={generatedImage} 
                  alt="Generated cosmic art"
                  class="w-full h-auto"
                  loading="lazy"
                />
              </div>
              
              <div class="bg-gradient-to-r from-purple-500/20 to-pink-500/20 rounded-xl p-6 border border-purple-300/30">
                <h3 class="text-2xl font-bold text-white mb-4">✨ Cosmic Art Generated!</h3>
                <p class="text-purple-100 text-lg leading-relaxed">
                  Your celestial masterpiece has been created based on your prompt: "{prompt}"
                </p>
                <div class="mt-6 space-y-3">
                  <div class="flex items-center gap-3">
                    <span class="text-2xl">🎨</span>
                    <span class="text-white">Art Style: Cosmic astrology theme</span>
                  </div>
                  <div class="flex items-center gap-3">
                    <span class="text-2xl">🌟</span>
                    <span class="text-white">Elements: Zodiac symbols, celestial formations</span>
                  </div>
                  <div class="flex items-center gap-3">
                    <span class="text-2xl">🌌</span>
                    <span class="text-white">Colors: Cosmic palette with mystical accents</span>
                  </div>
                </div>
              </div>
            </div>
          )}
        </div>

        <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white/10 backdrop-blur-lg rounded-xl p-6 text-center">
            <div class="text-4xl mb-4">🪐</div>
            <h3 class="text-xl font-bold text-white mb-2">Cosmic Themes</h3>
            <p class="text-purple-200">Astrology-inspired art with zodiac elements</p>
          </div>
          
          <div class="bg-white/10 backdrop-blur-lg rounded-xl p-6 text-center">
            <div class="text-4xl mb-4">🎭</div>
            <h3 class="text-xl font-bold text-white mb-2">AI Powered</h3>
            <p class="text-purple-200">Real image generation using DALL-E 3</p>
          </div>
          
          <div class="bg-white/10 backdrop-blur-lg rounded-xl p-6 text-center">
            <div class="text-4xl mb-4">🌠</div>
            <h3 class="text-xl font-bold text-white mb-2">High Quality</h3>
            <p class="text-purple-200">1024x1024 pixel professional artwork</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>