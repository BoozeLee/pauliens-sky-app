  "card_templates": {
    "profile_hero": {
      "type": "gradient_border",
      "border_radius": 20,
      "padding": 20,
      "border_width": 1,
      "art_position": "top_right",
      "art_opacity": 0.15,
      "gradient_begin": "topLeft",
      "gradient_end": "bottomRight"
    },
    "daily_reading": {
      "type": "gradient_fill",
      "border_radius": 18,
      "padding": 18,
      "gradient_begin": "topLeft",
      "gradient_end": "bottomRight",
