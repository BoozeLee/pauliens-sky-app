    },
    "fixed_star": {
      "type": "outlined",
      "border_radius": 14,
      "padding": 16,
      "expandable": true,
      "accent_source": "tradition",
      "accent_key": "yellow"
    },
    "sign_badge": {
      "type": "pill",
      "border_radius": 20,
      "padding_h": 10,
      "padding_v": 5,
      "bg_opacity": 0.12,
      "border_opacity": 0.4
    },
    "section_label": {
      "font_size": 10,
      "letter_spacing": 2.0,
      "color_key": "text_muted"
    },
